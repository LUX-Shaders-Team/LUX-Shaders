//==========================================================================//
//	Declare Static Combos
//==========================================================================//
// STATIC:	"ENVMAPMODE"				"0..4"
// STATIC:	"SELFILLUMMODE"				"0..2"
// STATIC:	"XBYBASEALPHA"				"0..2"
// STATIC:	"SSBUMP"					"0..1"
// STATIC:	"DETAILTEXTURE"				"0..1"
// STATIC:	"EXPONENTTEXTURE"			"0..1"

//==========================================================================//
//	Declare Dynamic Combos
//==========================================================================//
// DYNAMIC: "BICUBIC_FILTERING"			"0..1"

//==========================================================================//
//	Skipping undesired Combos
//	The Order of Static Combos and Skips has a drastic Impact on Compile Time!
//==========================================================================//
// SKIP: ( $ENVMAPMODE != 2 && $SELFILLUMMODE == 2 )
// SKIP: ( $ENVMAPMODE != 4 && $SELFILLUMMODE == 2 )

// I found several Community VMT's in SFM that utilize $SelfIllumMask with $BlendTintByBaseAlpha
// Well, it's technically the correct approach, it will no longer use the $BaseTexture's Alpha Channel
// SKIP: ( $SELFILLUMMODE == 1 && $XBYBASEALPHA != 0 )

//==========================================================================//
//	Unpack Combos specific to this Shader
//==========================================================================//

// FIXME: This shouldn't be necessary
#if EXPONENTTEXTURE
    #define PHONGEXPONENTTEXTURE 1
#endif

//==========================================================================//
//	Call into Main Function
//==========================================================================//

#define PHONG 1

#include "lux_lightmappedgeneric_main.h"